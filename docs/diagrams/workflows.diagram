# Generated by plotwork generate from the source workflows (github-actions: .github/workflows/publish.yml).
# The next run writes over this file. Put changes in docs/diagrams/workflows.overrides.json, or run plotwork generate --capture
# after an edit to keep it there, then run plotwork generate.
flow "Publish" direction=down desc="3 jobs and their steps of the Publish workflow, started by a push of a tag v* or a manual run, in the order their needs set, imported from GitHub Actions."

node on terminal "Push or manual run"

group job_publish "Publish to the Marketplace" type=ci-cd sub="ubuntu-latest" {
  node publish_1 step "Checkout" icon=simple:github
  node publish_2 step "Setup node" icon=simple:nodedotjs
  node publish_3 step "Decide what to publish"
  node publish_4 step "Sign in to Microsoft Entra with GitHub's OIDC token" icon=azure:cloud
  node publish_5 step "Print the service principal's Marketplace ID" icon=azure:cloud
  node publish_6 step "Pack and publish"
  node publish_7 step "Upload artifact" icon=lucide:upload
}

group job_release "Attach the .vsix to the GitHub Release" type=ci-cd sub="ubuntu-latest" {
  node release_1 step "Fetch the published .vsix"
  node release_2 step "Sign the provenance of the .vsix"
  node release_3 step "Create the release"
}

group job_smoke "Run the extension in Azure Pipelines" type=ci-cd sub="ubuntu-latest" {
  node smoke_1 step "Checkout" icon=simple:github
  node smoke_2 step "Read what to test"
  node smoke_3 step "Sign in to Microsoft Entra with GitHub's OIDC token" icon=azure:cloud
  node smoke_4 step "Run the smoke pipeline"
  node smoke_5 step "Run the write smoke on Azure Repos"
}

on -> publish_1
publish_1 -> publish_2
publish_2 -> publish_3
publish_3 -> publish_4
publish_4 -> publish_5
publish_5 -> publish_6
publish_6 -> publish_7
release_1 -> release_2
release_2 -> release_3
smoke_1 -> smoke_2
smoke_2 -> smoke_3
smoke_3 -> smoke_4
smoke_4 -> smoke_5
publish_7 -> release_1
publish_7 -> smoke_1
